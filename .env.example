# Both variables are optional — the site builds and runs with neither set.

# Canonical production URL, used for metadataBase, sitemap.xml, robots.txt,
# and JSON-LD. On Vercel this is inferred automatically from
# VERCEL_PROJECT_PRODUCTION_URL; set this only to override that (e.g. a
# custom domain) or when running a production build outside Vercel.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Overrides the default Formspree endpoint in app/contact/actions.ts.
# Useful to point a preview deploy at a separate test form.
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
